{
  "info": {
    "name": "MyHabit Backend API",
    "description": "Complete API collection for MyHabit Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Habits",
      "item": [
        {
          "name": "Get All Habits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/habits?include_checkins=true",
              "host": ["{{base_url}}"],
              "path": ["api", "habits"],
              "query": [
                {
                  "key": "include_checkins",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get Habit by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/habits/1?include_checkins=true",
              "host": ["{{base_url}}"],
              "path": ["api", "habits", "1"],
              "query": [
                {
                  "key": "include_checkins",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Create Habit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Morning Workout\",\n  \"description\": \"30 minutes cardio and strength training\",\n  \"category\": \"health\",\n  \"target_frequency\": 5,\n  \"reminder_time\": \"06:30\",\n  \"reminder_enabled\": true,\n  \"repeat_days\": \"MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY\",\n  \"color\": \"#EF4444\",\n  \"icon\": \"💪\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/habits",
              "host": ["{{base_url}}"],
              "path": ["api", "habits"]
            }
          }
        },
        {
          "name": "Update Habit",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Habit Name\",\n  \"target_frequency\": 6\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/habits/1",
              "host": ["{{base_url}}"],
              "path": ["api", "habits", "1"]
            }
          }
        },
        {
          "name": "Delete Habit",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/habits/1",
              "host": ["{{base_url}}"],
              "path": ["api", "habits", "1"]
            }
          }
        },
        {
          "name": "Get Habit Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/habits/1/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "habits", "1", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Check-ins",
      "item": [
        {
          "name": "Get Check-ins",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/checkins?habit_id=1&date=2025-01-15",
              "host": ["{{base_url}}"],
              "path": ["api", "checkins"],
              "query": [
                {
                  "key": "habit_id",
                  "value": "1"
                },
                {
                  "key": "date",
                  "value": "2025-01-15"
                }
              ]
            }
          }
        },
        {
          "name": "Create Check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habit_id\": 1,\n  \"date\": \"2025-01-30\",\n  \"completed_at\": \"06:35\",\n  \"note\": \"Great workout!\",\n  \"mood\": \"very_happy\",\n  \"is_late\": false,\n  \"minutes_late\": 0,\n  \"energy_level\": 5,\n  \"stress_level\": 1,\n  \"location\": \"gym\",\n  \"weather\": \"sunny\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/checkins",
              "host": ["{{base_url}}"],
              "path": ["api", "checkins"]
            }
          }
        },
        {
          "name": "Bulk Create Check-ins",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"check_ins\": [\n    {\n      \"habit_id\": 1,\n      \"date\": \"2025-01-30\",\n      \"completed_at\": \"06:35\",\n      \"mood\": \"happy\",\n      \"energy_level\": 4\n    },\n    {\n      \"habit_id\": 2,\n      \"date\": \"2025-01-30\",\n      \"completed_at\": \"07:00\",\n      \"mood\": \"very_happy\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/checkins/bulk",
              "host": ["{{base_url}}"],
              "path": ["api", "checkins", "bulk"]
            }
          }
        },
        {
          "name": "Delete Check-in",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/checkins/1",
              "host": ["{{base_url}}"],
              "path": ["api", "checkins", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Get All Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/sync",
              "host": ["{{base_url}}"],
              "path": ["api", "sync"]
            }
          }
        },
        {
          "name": "Sync Data from Mobile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habits\": [],\n  \"check_ins\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/sync",
              "host": ["{{base_url}}"],
              "path": ["api", "sync"]
            }
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "Get Templates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/templates",
              "host": ["{{base_url}}"],
              "path": ["api", "templates"]
            }
          }
        },
        {
          "name": "Create Custom Template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Custom Habit\",\n  \"description\": \"My custom habit template\",\n  \"category\": \"health\",\n  \"icon\": \"🎯\",\n  \"default_frequency\": \"daily\",\n  \"tags\": \"custom,health\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/templates",
              "host": ["{{base_url}}"],
              "path": ["api", "templates"]
            }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/templates/1",
              "host": ["{{base_url}}"],
              "path": ["api", "templates", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
