<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_surface"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="My Habits"
        app:titleTextColor="@color/md_theme_onSurface">

        <!-- Insights Button -->
        <ImageButton
            android:id="@+id/buttonInsights"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Insights"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:padding="12dp" />

        <!-- Settings Menu -->
        <ImageButton
            android:id="@+id/buttonSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@android:drawable/ic_menu_preferences"
            android:padding="12dp" />

    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHabits"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_habit" />

    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No habits yet.\nTap + to create your first habit!"
        android:textSize="16sp"
        android:textColor="@color/md_theme_onBackground"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddHabit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Add Habit"
        android:src="@android:drawable/ic_input_add"
        app:tint="@color/md_theme_onPrimary"
        app:backgroundTint="@color/md_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Test Notification Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonTestNotification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Test Notification"
        android:textSize="12sp"
        style="@style/Widget.Material3.Button.TonalButton"
        app:layout_constraintBottom_toTopOf="@id/fabAddHabit"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Test Prediction Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonTestPrediction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Generate Insights"
        android:textSize="12sp"
        style="@style/Widget.Material3.Button.TonalButton"
        app:layout_constraintBottom_toTopOf="@id/buttonTestNotification"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>